MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/triplog?retryWrites=true&w=majority
MONGODB_DB=triplog
JWT_SECRET=change-me
SUPERVISOR_NAMES=해수
SUPERVISOR_EMAILS=
PORT=3001
CORS_ORIGIN=
# Render Persistent Disk mount path (optional, e.g. /opt/render/project/src/uploads)
UPLOAD_DIR=
# Optional: refresh src/data/krTourBusOpenData.json from 공공데이터포털
# DATA_GO_KR_SERVICE_KEY=
# Public site URL (OAuth redirect). Production: https://triplog.my
APP_URL=
# Optional full override (must match Kakao/Google console exactly)
# KAKAO_REDIRECT_URI=https://triplog.my/api/auth/kakao/callback
# GOOGLE_REDIRECT_URI=https://triplog.my/api/auth/google/callback
# Kakao Developers → REST API 키, Redirect URI: {APP_URL}/api/auth/kakao/callback
KAKAO_REST_API_KEY=
# Optional: only scopes enabled under 카카오 로그인 > 동의항목 (KOE205 if mismatch). Example: profile_nickname,account_email
# KAKAO_OAUTH_SCOPE=
# Kakao Client Secret — 카카오 콘솔 REST API 키에서「Client Secret」사용 ON일 때만 필수 (OFF면 비워 두세요)
# KAKAO_CLIENT_SECRET=
# Google Cloud Console → OAuth 2.0 Client → Authorized redirect URIs (same as GOOGLE_REDIRECT_URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
