{
  "name": "triplog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "dev:all": "concurrently -k \"npm run dev:api\" \"npm run dev\"",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
