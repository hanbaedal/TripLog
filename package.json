{
  "name": "triplog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs",
